# /etc/civ/civ.env — права 600, владелец root. Значения — без кавычек.

# Где слушать: только локально, снаружи — через прокси. Порт необычный, чтобы не столкнуться с другими службами;
# если занят — поменяйте здесь и в настройке прокси.
CIV_ADDR=127.0.0.1:47613
# Файл базы SQLite (каталог должен быть доступен на запись пользователю civ).
CIV_DB=/var/lib/civ/civ.db
# Секрет для HMAC-хэша IP: 32+ случайных символа, например `openssl rand -hex 32`.
# Если поменять — уникальные подключения начнут считаться заново.
CIV_IP_SECRET=
# Вход на /stats (HTTP Basic). Пустой пароль — страница выключена.
CIV_ADMIN_USER=admin
CIV_ADMIN_PASSWORD=
# Офлайн-база стран (MaxMind DB): обновляет deploy/update-geo.sh. Пусто — страна не определяется.
CIV_GEO_DB=/var/lib/civ/country.mmdb
# Ограничение частоты запросов к /api на один адрес.
CIV_RATE_PER_MINUTE=30
CIV_RATE_BURST=20
